;
; quadrature_encoder.pio — PIO-based X4 quadrature decoder for RP2350 (Pico 2)
;
; One state machine per encoder channel.
;   pin_base     = channel A
;   pin_base + 1 = channel B
;
; On every confirmed state transition, pushes one 32-bit word to the RX FIFO:
;   bits [3:2] = previous state {B_old, A_old}
;   bits [1:0] = current  state {B_new, A_new}
;
; The C-side IRQ handler drains the FIFO and updates a counter via a 16-entry
; lookup table — identical to the X4 quadrature truth table.
;
; Glitch rejection
; ────────────────
; A state change must be confirmed by two consecutive identical samples before
; it is accepted.  At 5 MHz SM clock (200 ns per instruction), any glitch
; shorter than ~0.8 µs is transparently rejected.  This is more than sufficient
; for TXS0108E level-shifter ringing (typically <100 ns) without any software
; debounce and without the risk of dropping real encoder edges at speed.
;
; Timing (5 MHz SM clock, 200 ns/instruction)
; ────────────────────────────────────────────
;   No-change poll loop : 4 cycles =  0.8 µs  (effective sample rate ~1.25 MHz)
;   Confirmed transition: 14 cycles = 2.8 µs  (processing overhead per edge)
;   Rejected glitch     :  9 cycles = 1.8 µs
;
;   FIT0450 max edge rate at 160 RPM: ~20 kHz → one edge every 50 µs.
;   Headroom factor: 50 / 2.8 ≈ 18×.
;
; Register usage
; ──────────────
;   Y   = confirmed previous pin state {B, A} in bits [1:0]
;   X   = temporary: current pin reading
;   ISR = temporary: pin reads and transition word assembly
;   OSR = (unused)
;

.program quadrature_encoder

    ; ──── Initialisation (runs once) ────────────────────────────────────────
    ; Read starting pin state into Y (previous state register).
    in    pins, 2           ; ISR[1:0] = {B, A}
    mov   y, isr            ; Y = initial confirmed state
    mov   isr, null         ; clear ISR

    ; ──── Main polling loop ─────────────────────────────────────────────────
.wrap_target
loop:
    in    pins, 2           ; [1] ISR = current {B, A}  (ISR was 0 → ISR = pins)
    mov   x, isr            ; [2] X = current state
    mov   isr, null         ; [3] clear ISR for next iteration
    jmp   x!=y changed      ; [4] state differs from previous?
.wrap                        ; no change — hardware wraps to loop (0 extra cycles)

    ; ──── State changed — confirm with a second sample ──────────────────────
changed:
    in    pins, 2           ; [5] second sample
    mov   x, isr            ; [6] X = second reading
    mov   isr, null         ; [7] clear ISR
    jmp   x!=y confirmed    ; [8] still different from Y (previous)?  → real
    jmp   loop              ; [9] reverted to previous → glitch, discard

    ; ──── Confirmed transition — assemble and push ──────────────────────────
confirmed:
    in    y, 2              ; [10] ISR = 0..0 | prev[1:0]      (prev in low bits)
    in    x, 2              ; [11] ISR = 0..0 | prev[1:0] << 2 | curr[1:0]
    push  noblock           ; [12] send (prev<<2 | curr) to RX FIFO
    mov   isr, null         ; [13] clear ISR so next loop iteration starts clean
    mov   y, x              ; [14] update Y = confirmed new state
    jmp   loop              ; [15] back to polling


% c-sdk {

#include "hardware/clocks.h"
#include "hardware/gpio.h"

/**
 * Initialise one PIO state machine for X4 quadrature decoding.
 *
 * @param pio           PIO instance (pio0, pio1, or pio2 on RP2350)
 * @param sm            State machine index (0–3)
 * @param offset        Instruction memory offset from pio_add_program()
 * @param pin_A         GPIO number of encoder channel A; channel B MUST be pin_A+1
 * @param max_step_freq Maximum expected quadrature edge rate (Hz).
 *                      The SM clock is set to 4× this (4 instructions per poll).
 *                      Pass 0 for the default 5 MHz SM clock (~1.25 MHz sample rate).
 */
static inline void quadrature_encoder_program_init(
    PIO pio, uint sm, uint offset, uint pin_A, uint max_step_freq)
{
    pio_sm_config c = quadrature_encoder_program_get_default_config(offset);

    /* IN reads from pin_A (B is automatically pin_A+1) */
    sm_config_set_in_pins(&c, pin_A);

    /* ISR shifts LEFT, no autopush — we push manually */
    sm_config_set_in_shift(&c, false, false, 32);

    /* Join TX FIFO into RX → 8 entries deep (we never transmit) */
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);

    /* SM clock divider.  Default: 5 MHz on a 150 MHz RP2350 → div = 30. */
    float sys_hz = (float)clock_get_hz(clk_sys);
    float sm_hz;
    if (max_step_freq > 0) {
        sm_hz = (float)max_step_freq * 4.0f;
        if (sm_hz > sys_hz) sm_hz = sys_hz;
    } else {
        sm_hz = 5000000.0f;
    }
    sm_config_set_clkdiv(&c, sys_hz / sm_hz);

    /* Configure encoder pins as PIO inputs with pull-ups */
    pio_sm_set_consecutive_pindirs(pio, sm, pin_A, 2, false);
    pio_gpio_init(pio, pin_A);
    pio_gpio_init(pio, pin_A + 1);
    gpio_pull_up(pin_A);
    gpio_pull_up(pin_A + 1);

    /* Initialise and start */
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}

%}
